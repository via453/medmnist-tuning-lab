<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', display: 'flex', flexDirection: 'column', padding: 0, position: 'relative', fontFamily: '"Source Han Sans SC","Microsoft YaHei",Arial,sans-serif' }}>
