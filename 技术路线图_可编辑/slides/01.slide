        <Text style={{ fontSize: 18, color: '#1E4FA8', textAlign: 'center', marginTop: 2, marginBottom: 2 }}>▼</Text>
        <Box style={{ border: '1px solid #D9E2F0', display: 'flex', flexDirection: 'row' }}>
